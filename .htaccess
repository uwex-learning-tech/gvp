# Generic Video Player caching
# Install in the player folder on the server: /app/generic_video_player_v4/.htaccess

<IfModule mod_headers.c>
    # Drop ETags: Apache's "-gzip" ETags never match, so browsers
    # re-download files instead of getting a quick "not modified".
    # Last-Modified still works for that check.
    Header unset ETag

    # Player code, its page template and settings: browsers always check
    # for a newer copy before using a saved one, so updates reach everyone
    # right away. The template (.tpl) must match the script that fills it,
    # and without a rule browsers keep it for days.
    <FilesMatch "\.(js|css|json|html|tpl|xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Images and fonts: keep for a day without checking.
    <FilesMatch "\.(png|jpe?g|gif|svg|webp|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "max-age=86400"
    </FilesMatch>
</IfModule>
FileETag None
