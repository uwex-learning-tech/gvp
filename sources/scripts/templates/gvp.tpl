<div class="gvp-decoration-bar" aria-hidden="true"></div>

<div class="gvp-title-bar">
    <h1></h1>
</div>

<main class="gvp-video-wrapper">
    <div class="gvp-cover">
        <div class="gvp-program-logo" aria-hidden="true"></div>
        <p class="gvp-visually-hidden gvp-cover-status" role="status">Loading video&hellip;</p>
    </div>
    <div class="gvp-error-msg" role="alert" tabindex="-1" hidden></div>
    <div class="gvp-splash-meta">
        <div class="gvp-author-wrapper"><p class="gvp-author-name"></p></div>
        <div class="gvp-duration-badge" hidden></div>
    </div>
    <div class="gvp-splash-download-wrapper">
        <div class="gvp-splash-downloads"></div>
        <div class="gvp-download-list" hidden></div>
    </div>
    <video id="gvp-video" class="video-js vjs-default-skin vjs-16-9" playsinline="" crossorigin="anonymous"></video>
    <div class="gvp-program-logo" aria-hidden="true"></div>
</main>

<footer class="gvp-footer">
    <p>&copy; <span class="gvp-copyright-year"></span>. <span id="gvp_notice"></span></p>
</footer>
